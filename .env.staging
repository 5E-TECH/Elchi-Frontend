# TEST muhit (staging) build config: `npm run build:staging` (= `vite build --mode staging`).
# Sayt: https://test-admin.elchipochta.uz (Worker `elchi-frontend-test`, wrangler.jsonc → env.staging).
# NOTE: all VITE_* values are embedded into the client bundle and are therefore PUBLIC. Never put secrets here.
# VITE_APP_ENV=staging — «TEST muhit» belgisi, noindex, sarlavha prefiksi, CSP'da test API hosti (vite.config.ts →
# scripts/staging-build.mjs). VITE_BASE_URL production hosti bo'lsa yoki https bo'lmasa — build yiqiladi.
VITE_BASE_URL=https://test-api.elchipochta.uz/
VITE_APP_ENV=staging
VITE_DEBUG=false
