# Production build config.
# NOTE: all VITE_* values are embedded into the client bundle and are therefore
# PUBLIC. Never put secrets here. This file is committed so that `npm run build`
# always targets the production API, regardless of any local .env override
# (which is git-ignored and may point at an internal dev IP).
VITE_BASE_URL=https://api.elchipochta.uz/
VITE_DEBUG=false
