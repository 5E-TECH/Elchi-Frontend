# Production build config.
# NOTE: all VITE_* values are embedded into the client bundle and are therefore
# PUBLIC. Never put secrets here. This file is committed so that `npm run build`
# always targets the production API, regardless of any local .env override
# (which is git-ignored and may point at an internal dev IP).
# Bir domenli API (same-origin): ilova API'ga `https://admin.elchipochta.uz/api/*` orqali murojaat qiladi — CORS
# preflight yo'q. `/api/*` va `/socket.io/*` ni Worker (`worker/index.ts`) `wrangler.jsonc` → `vars.API_ORIGIN` ga
# proksi qiladi. VITE_PUBLIC_API_URL — API hostining o'zi: tashqi havolalar (Carrier API), CSP.
# Orqaga qaytish: Elchi-Backend docs/ops/same-origin-api.md §7.
VITE_BASE_URL=/api/
VITE_PUBLIC_API_URL=https://api.elchipochta.uz/
VITE_DEBUG=false
# Muhit belgisi: `import.meta.env.VITE_APP_ENV === "staging"` build vaqtida `false` bo'lib, TEST muhit kodi
# (src/widgets/staging-banner) production bundle'ga umuman tushmaydi. Bu qator bo'lmasa shart hisoblanmay qolardi.
VITE_APP_ENV=production
